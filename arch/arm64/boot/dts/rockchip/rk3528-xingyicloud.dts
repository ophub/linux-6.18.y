/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pwm/pwm.h>
#include "rk3528.dtsi"
#include "rk3528-op-pwm.dtsi"

/ {
	model = "XingyiCloud XY3528";
	compatible = "xingyicloud,xy3528", "rockchip,rk3528";

	aliases {
		ethernet0 = &gmac1;
		mmc0 = &sdhci;
		serial0 = &uart0;
		serial1 = &uart2;
	};

	chosen: chosen {
		stdout-path = "serial0:1500000n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x04000000>;
			linux,cma-default;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&power_led_pins>;

		led-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vdd5v0_sys: regulator-vdd5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vdd5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vdd_3v3: regulator-vdd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vdd5v0_sys>;
	};

	vdd_1v8: regulator-vdd-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vdd5v0_sys>;
	};

	vdd_ddr: regulator-vdd-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vdd_ddr";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vdd5v0_sys>;
	};

	vdd_0v9: regulator-vdd-0v9 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_0v9";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&vdd5v0_sys>;
	};

	vdd_arm: regulator-vdd-arm {
		compatible = "pwm-regulator";
		pwms = <&pwm1 0 5000 PWM_POLARITY_INVERTED>;
		regulator-always-on;
		regulator-boot-on;
		regulator-init-microvolt = <953000>;
		regulator-min-microvolt = <746000>;
		regulator-max-microvolt = <1201000>;
		regulator-name = "vdd_arm";
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vdd5v0_sys>;
		status = "okay";
	};

	vdd_logic: regulator-vdd-logic {
		compatible = "pwm-regulator";
		pwms = <&pwm2 0 5000 PWM_POLARITY_INVERTED>;
		regulator-always-on;
		regulator-boot-on;
		regulator-init-microvolt = <950000>;
		regulator-min-microvolt = <705000>;
		regulator-max-microvolt = <1006000>;
		regulator-name = "vdd_logic";
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vdd5v0_sys>;
		status = "okay";
	};

	/*
	 * VBUS for the USB 3.0 host port.
	 * The port is wired to the single DWC3 (OTG) controller with its
	 * companion USB2 PHY; a load switch on GPIO4_C4 supplies VBUS.
	 */
	vdd5v0_usb: regulator-vdd5v0-usb {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vdd5v0_usb_en>;
		regulator-always-on;
		regulator-boot-on;
		regulator-name = "vdd5v0_usb";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vdd5v0_sys>;
	};
};

/* combination PHY: used in USB3 mode for the USB 3.0 port (no PCIe device) */
&combphy {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

/*
 * Only GMAC1 is used on this board: RGMII to an external RTL8211F.
 * GMAC0 (RMII) is left disabled so that OpenWrt sees a single eth0.
 *
 * Delays follow the vendor Android tree: the PHY adds the RX delay
 * (phy-mode "rgmii-rxid") and the MAC adds the TX delay (tx_delay).
 */
&gmac1 {
	/*
	 * snps,tso can cause the netdev watchdog to time out on
	 * this GMAC; drop it.
	 */
	/delete-property/ snps,tso;

	clock_in_out = "output";
	phy-handle = <&rgmii_phy>;
	phy-mode = "rgmii-rxid";
	phy-supply = <&vdd_3v3>;

	pinctrl-names = "default";
	pinctrl-0 = <&rgmii_miim>, <&rgmii_tx_bus2>, <&rgmii_rx_bus2>,
		    <&rgmii_rgmii_clk>, <&rgmii_rgmii_bus>;

	tx_delay = <0x30>;
	rx_delay = <0x00>;

	status = "okay";
};

&gpu {
	mali-supply = <&vdd_logic>;
	status = "okay";
};

&mdio1 {
	rgmii_phy: ethernet-phy@1 {
		/* Realtek RTL8211F (phy id 0x001cc916) */
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x1>;

		pinctrl-names = "default";
		pinctrl-0 = <&gmac1_reset_l>;

		/* RTL8211F requires 20 ms assert / 100 ms deassert */
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	gmac {
		gmac1_reset_l: gmac1-reset-l {
			rockchip,pins = <4 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		power_led_pins: power-led-pins {
			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>,
					<4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		vdd5v0_usb_en: vdd5v0-usb-en {
			rockchip,pins = <4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm1m0_pins>;
	status = "okay";
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm2m0_pins>;
	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vdd_1v8>;
};

/* on-board 128 GiB eMMC */
&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk>, <&emmc_cmd>, <&emmc_strb>, <&emmc_bus8>;
	vmmc-supply = <&vdd_3v3>;
	vqmmc-supply = <&vdd_1v8>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

/* debug console: UART0 M0 on GPIO4_C7 (RX) / GPIO4_D0 (TX), 1.5 MBaud */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

/*
 * Realtek RTL8761BTV bluetooth, UART attached.
 */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer>, <&uart2m1_ctsn>, <&uart2m1_rtsn>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "bt-h4";
		enable-gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_HIGH>;
	};
};

&usb2phy {
	status = "okay";
};

/* the host port of the USB2 PHY is not wired out */
&usb2phy_host {
	status = "disabled";
};

&usb2phy_otg {
	status = "okay";
};

/* no USB2 host ports are populated */
&usb_host0_ehci {
	status = "disabled";
};

&usb_host0_ohci {
	status = "disabled";
};

/*
 * USB 3.0 port: DWC3 in host mode on the OTG controller, using the
 * OTG port of the USB2 PHY for USB2 fallback and the combination
 * PHY for SuperSpeed.
 */
&usb_host0_xhci {
	dr_mode = "host";
	phys = <&usb2phy_otg>, <&combphy PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	status = "okay";
};
